API_PORT=4310
API_HOST=127.0.0.1
ADMIN_ORIGIN=http://127.0.0.1:5180
USER_ORIGIN=http://127.0.0.1:5174
APP_MODE=test
# Empty uses local persistent PostgreSQL (PGlite); Linux uses PostgreSQL URL.
DATABASE_URL=
LOCAL_DATABASE_DIR=.local/database
# Supply only on first initialization. Never commit credentials.
ADMIN_PHONE=
ADMIN_PASSWORD=
# 64 hex characters. Generated locally when absent in test mode.
SECRET_KEY=
# GoCaptcha private service. Never expose its HTTP/gRPC ports to the public Internet.
GOCAPTCHA_URL=http://127.0.0.1:4311
# Only needed when the GoCaptcha public challenge/check endpoints require an API key.
GOCAPTCHA_API_KEY=
